{
  "columns": {
    "id":         { "type": "integer", "required": true, "min": 1 },
    "name":       { "type": "string",  "required": true },
    "email":      { "type": "email",   "required": true },
    "age":        { "type": "integer", "required": false, "min": 18, "max": 120 },
    "signup":     { "type": "date",    "required": true },
    "status":     { "type": "string",  "required": true, "allowed": ["active", "inactive"] },
    "balance":    { "type": "float",   "required": false, "min": 0 },
    "phone":      { "type": "string",  "required": false, "pattern": "\\+?[0-9 ]{7,15}" }
  },
  "key": "id"
}